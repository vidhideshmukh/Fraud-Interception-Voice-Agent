{"hash": "af06502ba486f5da", "kind": "state", "payload": {"after": "human_intro", "to": "awaiting_verification"}, "prev_hash": "8b8cfa218d4e394d", "seq": 7, "session_id": "call_650399cc01", "ts": 1784893753644}
{"hash": "f4f0fd4734f8b74d", "kind": "tts", "payload": {"text": "Thank you, I appreciate it. First, just so you can be completely sure this really is Barclays and to confirm your identity, please open your Barclays app \u2014 you'll see a verification code we've just sent you. Could you read that code back to me? To be clear, I will never ask for your PIN, your password or your full card number \u2014 this app code is only to confirm it's really you."}, "prev_hash": "af06502ba486f5da", "seq": 8, "session_id": "call_650399cc01", "ts": 1784893753645}
