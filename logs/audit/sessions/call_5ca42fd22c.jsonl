{"hash": "0e4610f5b27d30d3", "kind": "tts", "payload": {"text": "Thank you, Emily \u2014 that's verified, I appreciate it. Now, we paused a payment of \u00a3680 at Electronics Bazaar in Lagos. Can I just check with you \u2014 did you make this purchase?"}, "prev_hash": "110b69c4ba8b49e6", "seq": 11, "session_id": "call_5ca42fd22c", "ts": 1784892803734}
