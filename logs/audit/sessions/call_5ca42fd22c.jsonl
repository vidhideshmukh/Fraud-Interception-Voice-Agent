{"hash": "ce4a51c625f224c4", "kind": "tts", "payload": {"text": "Hello, am I speaking with Emily?"}, "prev_hash": "51592c7965c3667a", "seq": 2, "session_id": "call_5ca42fd22c", "ts": 1784892803728}
