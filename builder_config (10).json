{"hash": "927d3a4c72b0e97e", "kind": "tts", "payload": {"text": "Hello, am I speaking with Oliver?"}, "prev_hash": "ad0e562385eed6b6", "seq": 3, "session_id": "call_384d9c9eec", "ts": 1784892902376}
